# ==============================================================================
# Briefly Backend — Environment Variables
# ==============================================================================
# Copy this file to .env for local development. Never commit the real .env.
# Variables are grouped by the milestone that introduces them, so this file
# stays a complete reference as the project grows.

# --- Milestone 1: App & CORS ---
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173

# --- Milestone 2: Database (Neon) ---
# DATABASE_URL=postgresql://<user>:<password>@<pooled-host>/<db>
# DATABASE_URL_DIRECT=postgresql://<user>:<password>@<direct-host>/<db>

# --- Milestone 3: Supabase Auth ---
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_JWT_SECRET=          # only required if the project uses legacy HS256 signing
# SUPABASE_SERVICE_ROLE_KEY=    # or SUPABASE_SECRET_KEY on newer Supabase projects

# --- Milestone 4: Supabase Storage ---
# SUPABASE_STORAGE_BUCKET=meeting-audio

# --- Milestone 5/6: Groq ---
# GROQ_API_KEY=
# GROQ_LLM_MODEL=llama-4-scout   # verify current Groq model catalog at implementation time

# --- Milestone 13 (optional): Speaker Diarization ---
# HUGGINGFACE_TOKEN=